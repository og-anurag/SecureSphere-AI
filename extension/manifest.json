{
  "manifest_version": 3,
  "name": "SecureSphere AI",
  "version": "0.1.0",
  "description": "AI-powered digital security assistant for safer browsing.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SecureSphere AI",
    "default_popup": "popup.html"
  }
}