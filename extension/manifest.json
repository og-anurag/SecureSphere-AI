{
  "manifest_version": 3,
  "name": "SecureSphere AI",
  "version": "0.1.0",
  "description": "AI-powered digital security assistant for safer browsing.",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
  "<all_urls>",
  "http://127.0.0.1:8000/*"
],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SecureSphere AI",
    "default_popup": "popup.html"
  }
}